# Normalize line endings to LF in the repo (consistent across Windows/macOS/Linux).
* text=auto eol=lf

# Treat binary assets as binary (no EOL conversion / diffing).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.docx binary
*.pdf binary

# Generated graphify outputs — tracked, but suppress blob diffs (they churn
# on every rebuild). Still versioned; `git diff` just won't print their contents.
graphify-out/graph.html -diff
graphify-out/graph.json -diff
